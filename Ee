-- 7. Loop ระบบบินแบบ 3D และ Noclip
RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    if char then
        local hrp = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hrp and hum then
            -- ระบบ Noclip
            if Noclip then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
            
            -- ระบบ Fly (คำนวณตามทิศทางกล้องจริง 3D)
            if Flying then
                hum.PlatformStand = true
                hrp.AssemblyLinearVelocity = Vector3.zero -- ต้านแรงโน้มถ่วงไม่ให้ตก
                
                local cam = workspace.CurrentCamera
                local moveDir = hum.MoveDirection
                
                if moveDir.Magnitude > 0 then
                    -- แปลงทิศทางการเดินให้สัมพันธ์กับมุมกล้อง 3D (ขึ้น/ลง/ซ้าย/ขวา)
                    local localMove = cam.CFrame:VectorToObjectSpace(moveDir)
                    local flyDir = (cam.CFrame.LookVector * -localMove.Z) + (cam.CFrame.RightVector * localMove.X)
                    
                    if flyDir.Magnitude > 0 then
                        hrp.CFrame = hrp.CFrame + (flyDir.Unit * (FlySpeed * dt))
                    end
                end
            end
        end
    end
end)
